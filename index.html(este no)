// Sistema del Carrito
function addToCart(pId) {
  const p = P.find(x => x.id === pId);
  if (!p) return;
  const sIdx = sel[pId] !== undefined ? sel[pId] : (p.sizes.length - 1);
  const sizeObj = p.sizes[sIdx] || p.sizes[0];

  const cartItemId = `${p.id}-${sizeObj[0]}`;
  const existing = cart.find(it => it.cartId === cartItemId);

  if (existing) {
    existing.qty += 1;
  } else {
    cart.push({
      cartId: cartItemId,
      id: p.id,
      name: p.name,
      brand: p.brand,
      size: sizeObj[0],
      price: sizeObj[1],
      q: p.q,
      qty: 1
    });
  }

  updateCartUI();
  toggleCart(true);
}

function updateCartQty(cartId, delta) {
  const idx = cart.findIndex(it => (it.cartId || it.id) === cartId);
  if (idx < 0) return;
  cart[idx].qty += delta;
  if (cart[idx].qty <= 0) {
    cart.splice(idx, 1);
  }
  updateCartUI();
}

function removeCartItem(cartId) {
  cart = cart.filter(it => (it.cartId || it.id) !== cartId);
  updateCartUI();
}

function updateCartUI() {
  saveCart();
  const totalCount = cart.reduce((sum, it) => sum + it.qty, 0);
  const totalAmount = cart.reduce((sum, it) => sum + (it.price * it.qty), 0);

  if ($('badge')) $('badge').textContent = totalCount;
  if ($('botc')) $('botc').textContent = totalCount;
  if ($('tot')) $('tot').textContent = fmt(totalAmount);

  // Barra de progreso envío gratis
  const goalEl = $('goal');
  const barEl = $('bar');
  if (goalEl && barEl) {
    if (totalAmount >= GOAL) {
      goalEl.innerHTML = `🎉 <b>¡Felicidades!</b> Calificas para <b>ENVÍO GRATIS</b>.`;
      barEl.style.width = '100%';
    } else {
      const diff = GOAL - totalAmount;
      const pct = Math.min(100, Math.round((totalAmount / GOAL) * 100));
      goalEl.innerHTML = `Agrega <b>${fmt(diff)}</b> más para obtener <b>ENVÍO GRATIS</b>`;
      barEl.style.width = `${pct}%`;
    }
  }

  // Lista de items
  const itemsEl = $('items');
  if (!itemsEl) return;

  if (cart.length === 0) {
    itemsEl.innerHTML = `
      <div class="py-12 text-center text-gray-400">
        <svg class="w-12 h-12 mx-auto text-gray-600 mb-2" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path d="M6 7h12l1 13H5zM9 7a3 3 0 0 1 6 0"/></svg>
        <p class="font-title text-base text-gray-300">Tu carrito está vacío</p>
        <p class="text-xs text-gray-500 mt-1">Explora nuestro catálogo y agrega tus perfumes favoritos.</p>
        <button onclick="closeAll()" class="btn px-5 py-2 text-xs mt-4">Ver perfumes</button>
      </div>`;
    return;
  }

  itemsEl.innerHTML = cart.map(it => {
    const key = it.cartId || it.id;
    return `
      <div class="p-3 rounded-xl bg-ink-800 border border-gold-500/15 flex items-center justify-between gap-3">
        <div class="flex-1 min-w-0">
          <p class="text-[10px] uppercase tracking-wider text-gold-400 truncate">${it.brand}</p>
          <h4 class="font-title font-bold text-xs sm:text-sm text-white truncate">${it.name}</h4>
          <p class="text-[11px] text-gray-400">${it.size}ml · <b class="text-gold-200">${fmt(it.price)}</b></p>
        </div>
        <div class="flex items-center gap-2">
          <div class="flex items-center border border-ink-600 rounded-lg overflow-hidden bg-ink-900">
            <button onclick="updateCartQty('${key}', -1)" class="px-2 py-1 text-xs text-gray-300 hover:bg-ink-700">-</button>
            <span class="px-2 text-xs font-bold text-white">${it.qty}</span>
            <button onclick="updateCartQty('${key}', 1)" class="px-2 py-1 text-xs text-gray-300 hover:bg-ink-700">+</button>
          </div>
          <button onclick="removeCartItem('${key}')" class="text-gray-400 hover:text-red-400 p-1" title="Eliminar">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
          </button>
        </div>
      </div>
    `;
  }).join('');
}

// Finalizar pedido por WhatsApp
function checkout() {
  if (cart.length === 0) {
    alert("Tu carrito está vacío. ¡Elige tus fragancias antes de continuar!");
    return;
  }

  const lines = cart.map(it => {
    return `• ${it.qty}x ${it.name} (${it.brand}) - ${it.size}ml: ${fmt(it.price * it.qty)}`;
  });
  const total = cart.reduce((sum, it) => sum + (it.price * it.qty), 0);
  const freeShip = total >= GOAL ? "✅ Aplica para ENVÍO GRATIS" : "📦 Envío estándar nacional";

  const msg = `¡Hola Scent_Perfums! 👋 Deseo realizar el siguiente pedido:\n\n${lines.join('\n')}\n\n💰 *Subtotal:* ${fmt(total)}\n🚚 *Envío:* ${freeShip}\n\n¿Me confirman disponibilidad y medios de pago (Nequi, Bancolombia o Contraentrega)? Gracias.`;
  
  // Reemplaza con tu número de WhatsApp real de Colombia (código país 57)
  const phone = "573000000000";
  const url = `https://wa.me/${phone}?text=${encodeURIComponent(msg)}`;
  window.open(url, '_blank');
}

// Modales y Drawers
function toggleCart(show) {
  const c = $('cart');
  const ov = $('ov');
  if (show) {
    c.classList.remove('translate-x-full');
    ov.classList.remove('hidden');
    updateCartUI();
  } else {
    c.classList.add('translate-x-full');
    ov.classList.add('hidden');
  }
}

function toggleFilters(show) {
  const f = $('fil');
  const ov = $('ov');
  if (show) {
    renderFilterBody();
    f.classList.remove('-translate-x-full');
    ov.classList.remove('hidden');
  } else {
    f.classList.add('-translate-x-full');
    ov.classList.add('hidden');
  }
}

function toggleMenu(show) {
  const m = $('menu');
  if (show) m.classList.remove('hidden'), m.classList.add('flex');
  else m.classList.add('hidden'), m.classList.remove('flex');
}

function toggleBot() {
  const b = $('bot');
  b.classList.toggle('hidden');
}

function openModal(id) {
  const el = $(id);
  if (!el) return;
  el.classList.remove('hidden');
  el.classList.add('flex');
  if (id === 'sm') {
    const mq = $('mq');
    if (mq) {
      mq.value = '';
      mq.focus();
      modalSearch();
    }
  }
}

function closeAll() {
  toggleCart(false);
  toggleFilters(false);
  toggleMenu(false);
  const sm = $('sm');
  if (sm) {
    sm.classList.add('hidden');
    sm.classList.remove('flex');
  }
  $('ov').classList.add('hidden');
}

// Búsqueda en modal
function modalSearch() {
  const q = ($('mq').value || '').trim().toLowerCase();
  const resEl = $('mres');
  if (!resEl) return;

  const results = P.filter(p => {
    if (!q) return true;
    return p.name.toLowerCase().includes(q) ||
           p.brand.toLowerCase().includes(q) ||
           p.notes.toLowerCase().includes(q) ||
           p.tipo.toLowerCase().includes(q);
  }).slice(0, 6);

  if (results.length === 0) {
    resEl.innerHTML = `<p class="text-xs text-gray-500 py-4 text-center">No encontramos coincidencias para "${q}".</p>`;
    return;
  }

  resEl.innerHTML = results.map(p => {
    const s = p.sizes[p.sizes.length - 1];
    return `
      <div class="p-2.5 rounded-xl bg-ink-900 border border-ink-700 flex items-center justify-between gap-3 hover:border-gold-500/40 transition-colors">
        <div>
          <span class="text-[10px] text-gold-300 font-semibold">${p.brand} · ${p.q}</span>
          <h4 class="font-title text-sm text-white font-bold leading-tight">${p.name}</h4>
          <span class="text-xs text-gold-200 font-medium">${fmt(s[1])}</span>
        </div>
        <button onclick="closeAll();addToCart(${p.id});" class="btn px-3 py-1.5 text-xs">
          Agregar
        </button>
      </div>
    `;
  }).join('');
}

