// Control de Filtros
function toggleFilter(cat, val) {
  if (F[cat].has(val)) F[cat].delete(val);
  else F[cat].add(val);
  updateActiveChips();
  renderCat();
  renderFilterBody();
}

function clearF() {
  Object.keys(F).forEach(k => F[k].clear());
  Q = '';
  if ($('q')) $('q').value = '';
  updateActiveChips();
  renderCat();
  renderFilterBody();
}

function setQ(v) {
  Q = v.trim().toLowerCase();
  renderCat();
}

function quickTipo(tipo) {
  F.tipo.clear();
  F.tipo.add(tipo);
  updateActiveChips();
  renderCat();
  renderFilterBody();
  window.location.hash = '#catalogo';
}

function updateActiveChips() {
  const container = $('active');
  let activeList = [];
  Object.keys(F).forEach(key => {
    F[key].forEach(val => activeList.push({ key, val }));
  });

  const fcount = $('fcount');
  if (fcount) {
    if (activeList.length > 0) {
      fcount.textContent = activeList.length;
      fcount.classList.remove('hidden');
      fcount.classList.add('flex');
    } else {
      fcount.classList.add('hidden');
      fcount.classList.remove('flex');
    }
  }

  if (activeList.length === 0) {
    container.innerHTML = '';
    return;
  }

  container.innerHTML = `
    <div class="flex items-center gap-1 text-xs text-gray-400 mr-2">Filtros aplicados:</div>
    ${activeList.map(item => `
      <span class="chip on text-xs flex items-center gap-1.5" onclick="toggleFilter('${item.key}', '${item.val}')">
        ${item.val} <span class="text-[10px] opacity-75">✕</span>
      </span>
    `).join('')}
    <button onclick="clearF()" class="text-xs text-gold-300 underline hover:text-white ml-2">Borrar filtros</button>
  `;
}

// Filtrado de perfumes
function getFilteredPerfumes() {
  let list = P.filter(p => {
    if (Q) {
      const matchName = p.name.toLowerCase().includes(Q);
      const matchBrand = p.brand.toLowerCase().includes(Q);
      const matchNotes = p.notes.toLowerCase().includes(Q);
      if (!matchName && !matchBrand && !matchNotes) return false;
    }
    if (F.tipo.size > 0 && !F.tipo.has(p.tipo)) return false;
    if (F.gen.size > 0 && !F.gen.has(p.gen)) return false;
    if (F.cal.size > 0 && !F.cal.has(p.q)) return false;
    if (F.marca.size > 0 && !F.marca.has(p.brand)) return false;
    if (F.cat.size > 0) {
      const hasAnyCat = p.cats.some(c => F.cat.has(c));
      if (!hasAnyCat) return false;
    }
    return true;
  });

  const sortVal = $('sort') ? $('sort').value : 'new';
  if (sortVal === 'lo') {
    list.sort((a,b) => {
      const pa = a.sizes[sel[a.id] || (a.sizes.length-1)][1];
      const pb = b.sizes[sel[b.id] || (b.sizes.length-1)][1];
      return pa - pb;
    });
  } else if (sortVal === 'hi') {
    list.sort((a,b) => {
      const pa = a.sizes[sel[a.id] || (a.sizes.length-1)][1];
      const pb = b.sizes[sel[b.id] || (b.sizes.length-1)][1];
      return pb - pa;
    });
  }
  return list;
}

function renderCat() {
  const filtered = getFilteredPerfumes();
  const grid = $('grid');
  const count = $('rcount');

  if (count) count.textContent = `Mostrando ${filtered.length} de ${P.length} perfumes disponibles`;

  if (filtered.length === 0) {
    grid.innerHTML = `
      <div class="col-span-full py-16 text-center card p-8">
        <p class="text-4xl mb-3">🔍</p>
        <h4 class="font-title text-xl font-bold gold-text">No encontramos coincidencias</h4>
        <p class="text-sm text-gray-400 mt-2">Prueba ajustando los filtros o realizando otra búsqueda.</p>
        <button onclick="clearF()" class="btn px-6 py-2.5 text-xs mt-4">Restablecer filtros</button>
      </div>`;
    return;
  }

  grid.innerHTML = filtered.map(p => card(p, false)).join('');
}

// Rails de Destacados y Nichos
function renderRails() {
